  },
  "item": [
    {
      "name": "Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/healthcheck",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "healthcheck"
          ]
        }
      }
    },
    {
      "name": "Register (POST /user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"ivan\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200/201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "const id = json?.id ?? json?.user_id ?? json?.userId;",
              "if (id !== undefined && id !== null && String(id).length > 0) {",
              "  pm.environment.set('userId', String(id));",
              "  pm.collectionVariables.set('userId', String(id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (POST /login) -> sets accessToken",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"ivan\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
              "const json = pm.response.json();",
              "const token = json?.access_token ?? json?.accessToken ?? json?.token;",
              "if (token) {",
              "  pm.environment.set('accessToken', String(token));",
              "  pm.collectionVariables.set('accessToken', String(token));",
              "}",
              "const id = json?.user_id ?? json?.userId;",
              "if (id !== undefined && id !== null && String(id).length > 0) {",
              "  pm.environment.set('userId', String(id));",
              "  pm.collectionVariables.set('userId', String(id));",
              "}"
            ]
          }
        }
      ]
    },
